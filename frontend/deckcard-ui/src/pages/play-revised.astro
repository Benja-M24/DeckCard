---
/**
 * Play.astro - Main game room management page
 *
 * Esta página sirve como contenedor principal para los componentes de gestión de salas de juego:
 * - CreateorJoinRoom: Maneja la creación y unión a salas
 * - RoomView: Muestra y gestiona la información de la sala actual
 *
 * Siguiendo los principios SOLID con una clara separación de responsabilidades:
 * - Responsabilidad Única: Cada componente maneja su tarea específica
 * - Abierto/Cerrado: Los componentes están diseñados para extensión
 * - Segregación de Interfaces: Límites claros entre componentes
 * - Inversión de Dependencias: Los componentes dependen de abstracciones
 */

// Importaciones de diseño y componentes
import Layout from "@layouts/Layout.astro";
import RoomView from "@components/RoomView.astro";
import CreateorJoinRoom from "@components/CreateorJoinRoom.astro";

// Importaciones de tipos
import type { Version as VersionType } from "../models/types";

// Importación de servicios API para obtención de datos
import { ApiService } from "../utils/ApiService";

/**
 * Capa de obtención de datos
 * Siguiendo el enfoque API-first y los principios de inmutabilidad
 */

// Obtener versiones de juego disponibles desde la API
let versions: VersionType[] = [];
try {
    versions = await ApiService.getVersions();
} catch (error) {
    console.error("Error al cargar versiones del juego:", error);
    // Proporcionar array vacío como fallback para prevenir errores en la UI
}

// Obtener código de sala desde la URL si está disponible
const selectedRoomCode = Astro.url.searchParams.get("Room");
---

<Layout>
    <section class="w-full max-w-full overflow-hidden py-8">
        <!-- Create or join a room -->
        <div class="flex flex-col justify-center items-center">
            <CreateorJoinRoom
                selectedRoomCode={selectedRoomCode}
                versions={versions}
            />
            <RoomView selectedRoomCode={selectedRoomCode} />
        </div>
    </section>

    <script>
        import { gameRoomStore } from "../stores/gameRoomStore";

        /**
         * Script principal de play.astro
         * La lógica específica ha sido delegada a los componentes CreateorJoinRoom y RoomView
         * Este script solo maneja la suscripción básica al store global para monitorear errores
         */
        document.addEventListener("DOMContentLoaded", () => {
            // Suscribirse a cambios en el estado global
            gameRoomStore.subscribe((state) => {
                // Registrar errores en la consola para depuración
                if (state.error) {
                    console.error("Error en el estado global:", state.error);
                }
            });
        });
    </script>
</Layout>
