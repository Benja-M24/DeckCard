---
import Layout from "@layouts/Layout.astro";
import type { Mazo } from "@utils/ApiService";
import {
    getMazosFromAPI,
    joinRoomFromAPI,
    createRoomOnAPI,
    createParticipantOnAPI,
    getParticipantsFromAPI,
} from "@utils/ApiService";

const mazos: Mazo[] = await getMazosFromAPI();
---

<Layout>
    <section class="w-full max-w-full overflow-hidden py-8">
        <!-- Create or join a room -->
        <div class="flex flex-col justify-center items-center">
            <div
                class="w-full max-w-md mx-auto bg-white rounded-xl shadow-md p-6 mb-8"
            >
                <h1 class="text-2xl font-bold self-center px-2 pt-2">
                    Start playing
                </h1>
                <p class="px-2 pb-2 text-gray-700 text-sm">
                    Create a room or join an existing one and start playing.
                </p>
                <div class="flex justify-between items-center p-2 mb-6">
                    <h2 class="text-lg font-bold">Modo de juego</h2>
                    <div class="flex items-center">
                        <span class="mr-3 text-sm font-medium text-gray-700"
                            >Unirse</span
                        >
                        <label
                            class="relative inline-flex items-center cursor-pointer"
                        >
                            <input
                                type="checkbox"
                                id="room-toggle"
                                class="sr-only peer"
                            />
                            <div
                                class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-amber-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-600"
                            >
                            </div>
                        </label>
                        <span class="ml-3 text-sm font-medium text-gray-700"
                            >Crear</span
                        >
                    </div>
                </div>

                <div id="join-room-form" class="mb-4">
                    <div class="mb-4">
                        <label
                            for="player-name"
                            class="block text-sm font-medium text-gray-700 mb-1"
                            >Nombre del jugador</label
                        >
                        <input
                            type="text"
                            id="player-name"
                            placeholder="Nombre del jugador"
                            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500"
                        />
                        <label
                            for="room-code"
                            class="block text-sm font-medium text-gray-700 mb-1"
                            >Código de sala</label
                        >
                        <input
                            type="text"
                            id="room-code"
                            placeholder="Ingresa el código"
                            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500"
                        />
                    </div>
                    <button
                        type="button"
                        id="join-room"
                        class="w-full bg-amber-600 hover:bg-amber-500 text-white font-medium py-2 px-4 rounded-md transition-colors duration-300"
                    >
                        Unirse a sala
                    </button>
                </div>

                <div id="create-room-form" class="hidden mb-4">
                    <div class="mb-4">
                        <label
                            for="admin-name"
                            class="block text-sm font-medium text-gray-700 mb-1"
                            >Nombre del jugador admin</label
                        >
                        <input
                            type="text"
                            id="admin-name"
                            placeholder="Nombre del anfitrion"
                            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500"
                        />
                        <label
                            for="room-name"
                            class="block text-sm font-medium text-gray-700 mb-1"
                            >Nombre de sala</label
                        >
                        <input
                            type="text"
                            id="room-name"
                            placeholder="Ingresa un nombre para la sala"
                            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500"
                        />
                        <label
                            for="mazo-version"
                            class="block text-sm font-medium text-gray-700 mb-1"
                            >Mazo</label
                        >
                        <select
                            id="mazo-version"
                            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500"
                        >
                            {
                                mazos.map((mazo) => (
                                    <option
                                        class="text-gray-600 text-sm py-1 px-2"
                                        value={mazo.id}
                                    >
                                        {mazo.nombre} (V{mazo.version})
                                    </option>
                                ))
                            }
                        </select>
                        <label
                            for="players-number"
                            class="block text-sm font-medium text-gray-700 mb-1"
                            >Número de jugadores</label
                        >
                        <input
                            type="number"
                            id="players-number"
                            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-500"
                        />
                    </div>
                    <button
                        type="button"
                        id="create-room"
                        class="w-full bg-amber-600 hover:bg-amber-500 text-white font-medium py-2 px-4 rounded-md transition-colors duration-300"
                    >
                        Crear sala
                    </button>
                </div>
            </div>

            <script>
                import {
                    createRoomOnAPI,
                    joinRoomFromAPI,
                } from "@utils/ApiService";

                document.addEventListener("DOMContentLoaded", () => {
                    const toggle = document.getElementById(
                        "room-toggle",
                    ) as HTMLInputElement;
                    const joinForm = document.getElementById("join-room-form");
                    const createForm =
                        document.getElementById("create-room-form");
                    const createRoomButton =
                        document.getElementById("create-room");
                    const joinRoomButton = document.getElementById("join-room");

                    if (toggle && joinForm && createForm) {
                        toggle.addEventListener("change", () => {
                            if (toggle.checked) {
                                joinForm.classList.add("hidden");
                                createForm.classList.remove("hidden");
                            } else {
                                joinForm.classList.remove("hidden");
                                createForm.classList.add("hidden");
                            }
                        });
                    }

                    if (createRoomButton) {
                        createRoomButton.addEventListener("click", () => {
                            console.log("Botón de creación de sala presionado");
                            const roomName = (
                                document.getElementById(
                                    "room-name",
                                ) as HTMLInputElement
                            ).value;
                            const adminName = (
                                document.getElementById(
                                    "admin-name",
                                ) as HTMLInputElement
                            ).value;
                            const mazoId = parseInt(
                                (
                                    document.getElementById(
                                        "mazo-version",
                                    ) as HTMLSelectElement
                                ).value,
                            );
                            const playersNumber = parseInt(
                                (
                                    document.getElementById(
                                        "players-number",
                                    ) as HTMLInputElement
                                ).value,
                            );

                            createRoomOnAPI(
                                roomName,
                                adminName,
                                mazoId,
                                playersNumber,
                            );
                        });
                    }

                    if (joinRoomButton) {
                        joinRoomButton.addEventListener("click", () => {
                            console.log("Botón de unión a sala presionado");
                            const roomCode = (
                                document.getElementById(
                                    "room-code",
                                ) as HTMLInputElement
                            ).value;

                            joinRoomFromAPI(roomCode);
                        });
                    }
                });
            </script>
        </div>
    </section>
</Layout>
