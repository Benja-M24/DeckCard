---
import Layout from "@layouts/Layout.astro";
import VersionSelector from "@components/VersionSelector.astro";
import CardFilter from "@components/CardFilter.astro";
import CardViewer from "@components/CardViewer.astro";
import VersionControls from "@components/VersionControls.astro";
import type {
    Version as VersionType,
    CartaPersonaje,
    CartaNegocio,
    CartaEspecial,
} from "../models/types";
import {
    getVersionsFromAPI,
    getCartasPersonajeFromAPI,
    getCartasNegocioFromAPI,
    getCartasEspecialesFromAPI,
} from "@utils/ApiService";
import { sampleVersion } from "../services/MockData";

// Obtener parámetros de la URL
const selectedVersionId = Astro.url.searchParams.get("version");
const selectedCardType = Astro.url.searchParams.get("type");
const cardIndexParam = Astro.url.searchParams.get("cardIndex");

let versions: VersionType[] = [sampleVersion];

if (!selectedVersionId) {
    versions = await getVersionsFromAPI();
}

let cartas: (CartaPersonaje | CartaNegocio | CartaEspecial)[] = [];
if (selectedCardType === "personaje") {
    cartas = await getCartasPersonajeFromAPI(selectedVersionId);
} else if (selectedCardType === "negocio") {
    cartas = await getCartasNegocioFromAPI(selectedVersionId);
} else if (selectedCardType === "especial") {
    cartas = await getCartasEspecialesFromAPI(selectedVersionId);
}

// Manejar índice de la carta actual
const currentCardIndex = cardIndexParam ? parseInt(cardIndexParam) : 0;
const maxCardIndex = Array.isArray(cartas) ? cartas.length - 1 : 0;
---

<Layout>
    <section class="w-full max-w-full overflow-hidden py-8">
        <!-- Selector de Versiones -->
        <VersionSelector
            versions={versions}
            selectedVersionId={selectedVersionId}
        />

        <!-- Card viewer -->
        <div
            class={`flex flex-col lg:gap-6 items-center mb-8 px-2 sm:px-4 lg:px-6 w-full ${!selectedCardType ? "lg:flex-col" : "lg:flex-row"}`}
        >
            <!-- Filtro de Tipos de Cartas -->
            <CardFilter
                selectedVersionId={selectedVersionId}
                selectedCardType={selectedCardType}
            />

            <!-- Visualizador de Cartas -->
            <CardViewer
                selectedVersionId={selectedVersionId}
                selectedCardType={selectedCardType}
                cartas={cartas}
                currentCardIndex={currentCardIndex}
            />
        </div>
        <VersionControls
            selectedVersionId={selectedVersionId}
            selectedCardType={selectedCardType}
            currentCardIndex={currentCardIndex}
            maxCardIndex={maxCardIndex}
        />
    </section>
</Layout>
