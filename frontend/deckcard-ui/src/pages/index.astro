---
import Layout from "@layouts/Layout.astro";
// import MazoSelector from "@components/MazoSelector.astro";
// import BaseCard from "@components/BaseCard.astro";
// import CartaNegocio from "@components/CartaNegocio.astro";
// import CartaEspecial from "@components/CartaEspecial.astro";
// import CartaPersonaje from "@components/CartaPersonaje.astro";

// Get the active component from the URL or default to "mazo"
const activeComponent = Astro.url.searchParams.get("component") || "mazo";

// Sample mazos data
const sampleMazos = [
    {
        id: 1,
        nombre: "Mazo Demo",
        version: "1.0",
        fecha_creacion: "2023-01-01",
    },
    {
        id: 2,
        nombre: "Mazo Avanzado",
        version: "3.5.1",
        fecha_creacion: "2023-02-15",
    },
    {
        id: 3,
        nombre: "Mazo god",
        version: "2.4.26",
        fecha_creacion: "2023-02-15",
    },
    {
        id: 4,
        nombre: "Mazo chido",
        version: "6-alpha",
        fecha_creacion: "2023-02-15",
    },
];

// Sample business card data
const sampleCartaNegocio = {
    titulo: "Café Internet",
    subtitulo: "Local de servicios digitales",
    tipo: "Negocio",
    costo: 5000,
    beneficio_base: 1000,
    beneficios_por_turno: [1500, 2500, 4000],
    niveles_soportados: [{ n_nivel: 1 }, { n_nivel: 2 }, { n_nivel: 3 }],
};

// Sample special card data
const sampleCartaEspecial = {
    titulo: "Evento Inesperado",
    frase: "La fortuna favorece a los audaces",
    consigna: "Roba 2 cartas adicionales en tu próximo turno",
    imagen: "/placeholder-special.jpg",
};

// Sample character card data
const sampleCartaPersonaje = {
    nombre: "Carlos Emprendedor",
    historia:
        "Comenzó desde abajo y ahora es dueño de varios negocios en la ciudad",
    edad: 42,
    sexo: "M",
    imagen: "/placeholder-character.jpg",
    atributos: {
        karma: 7,
        dinero: 9,
        fama: 6,
    },
};
---

<Layout>
    <header
        class="bg-gradient-to-r from-black to-amber-900 text-white shadow-md px-4 py-1 mb-6 w-full"
    >
        <div class="flex flex-wrap my-4 mx-2">
            <h1 class="text-[min(10vw,50px)] font-bold self-center">
                DeckCard
            </h1>
            <nav class="flex justify-end flex-1 py-4">
                <a
                    href="?component=carta-negocio"
                    class="flex items-center justify-center px-4 h-full rounded-md font-medium transition-colors duration-200 shadow-sm text-white bg-amber-600 hover:bg-amber-500"
                >
                    BM
                </a>
            </nav>
        </div>
    </header>
    <!-- show personaje card -->
    <section class="w-full max-w-full overflow-hidden py-8">
        <div
            class="flex flex-col lg:flex-row lg:gap-6 items-center mb-8 px-1 sm:px-2 max-w-full"
        >
            <!-- Filtro de cartas - 1/4 en pantallas grandes, full width en pequeñas -->
            <div
                class="w-[min(80vw,500px)] lg:max-w-1/4 mb-6 lg:mb-0 lg:justify-left"
            >
                <h3 class="text-lg font-bold py-2">Filtro de cartas</h3>
                <div
                    class="flex flex-col sm:flex-row xs:flex-wrap lg:flex-col gap-3 sm:gap-4 items-center w-full"
                >
                    <a
                        href="?component=carta-negocio"
                        class="px-4 py-2 rounded-md font-medium flex items-center justify-center text-center text-sm md:text-md lg:text-xl transition-colors duration-300 text-white bg-amber-600 hover:bg-amber-500 sm:flex-1 lg:flex-1 w-3/4 h-[min(12vw,70px)] truncate"
                    >
                        Cartas de Negocio
                    </a>
                    <a
                        href="?component=carta-especial"
                        class="px-4 py-2 rounded-md font-medium flex items-center justify-center text-center text-sm md:text-md lg:text-xl transition-colors duration-300 text-white bg-amber-600 hover:bg-amber-500 sm:flex-1 lg:flex-1 w-3/4 h-[min(12vw,70px)] truncate"
                    >
                        Cartas Especiales
                    </a>
                    <a
                        href="?component=carta-personaje"
                        class="px-4 py-2 rounded-md font-medium flex items-center justify-center text-center text-sm md:text-md lg:text-xl transition-colors duration-300 text-white bg-amber-600 hover:bg-amber-500 sm:flex-1 lg:flex-1 w-3/4 h-[min(12vw,70px)] truncate"
                    >
                        Cartas de Personaje
                    </a>
                </div>
            </div>

            <!-- Contenido de la carta - 3/4 en pantallas grandes, full width en pequeñas -->
            <div
                class="max-w-xs sm:max-w-md md:max-w-lg lg:max-w-full lg:justify-right rounded-3xl border-gray-500 border-l-1 border-b-2 border-t-3 border-r-3 shadow-xl relative"
            >
                <div class="static">
                    <div
                        class="absolute top-1/2 right-0 transform translate-x-1/2 -translate-y-1/2 rounded-full bg-gray-400 hover:bg-gray-300 transition-colors duration-100 cursor-pointer font-bold text-gray-100 w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center z-10"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-6 w-6"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 5l7 7-7 7"></path>
                        </svg>
                    </div>
                    <div
                        class="absolute top-1/2 left-0 transform -translate-x-1/2 -translate-y-1/2 rounded-full bg-gray-400 hover:bg-gray-300 transition-colors duration-100 cursor-pointer font-bold text-gray-100 w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center z-10"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-6 w-6"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 5l-7 7 7 7"></path>
                        </svg>
                    </div>
                </div>
                <div class="p-4">
                    <h2 class="text-2xl font-bold mb-4">Personaje</h2>
                    <div class="flex justify-center flex-col lg:flex-row gap-6">
                        <div
                            class="flex flex-col items-center lg:items-start gap-2"
                        >
                            <img
                                src="https://picsum.photos/200/300"
                                alt="Personaje1"
                                class="w-[min(30vw,600px)] h-[min(30vw,300px)] rounded-3xl shadow-md"
                            />
                            <div class="text-center md:text-left">
                                <h3 class="text-lg font-bold">
                                    {sampleCartaPersonaje.nombre}
                                </h3>
                                <p class="text-sm text-gray-600">
                                    {sampleCartaPersonaje.historia}
                                </p>
                            </div>
                        </div>
                        <div
                            class="flex flex-col xs:flex-row md:flex-col gap-4 mt-4 md:mt-0"
                        >
                            <div class="text-center md:text-left">
                                <h3 class="text-md text-center font-bold">
                                    Características y Atributos
                                </h3>
                                <p class="text-md text-justify text-gray-800">
                                    {sampleCartaPersonaje.historia}
                                </p>
                            </div>

                            <div
                                class="grid grid-cols-3 justify-center md:items-start"
                            >
                                <div
                                    class="col-span-1 flex flex-col items-center"
                                >
                                    <div
                                        class="bg-blue-400 rounded-full w-1/3 my-2 p-2 font-bold text-center text-xs sm:text-md md:text-lg lg:text-xl"
                                    >
                                        <p class="flex justify-center">
                                            {
                                                sampleCartaPersonaje.atributos
                                                    .karma
                                            }
                                        </p>
                                    </div>
                                    <dt
                                        class="flex justify-center text-xs sm:text-md md:text-lg lg:text-xl font-bold"
                                    >
                                        Karma
                                    </dt>
                                </div>
                                <div
                                    class="col-span-1 flex flex-col items-center"
                                >
                                    <div
                                        class="bg-green-600 rounded-full w-1/3 my-2 p-2 font-bold text-center text-xs sm:text-md md:text-lg lg:text-xl"
                                    >
                                        <p class="flex justify-center">
                                            {
                                                sampleCartaPersonaje.atributos
                                                    .dinero
                                            }
                                        </p>
                                    </div>
                                    <dt
                                        class="flex justify-center text-xs sm:text-md md:text-lg lg:text-xl font-bold"
                                    >
                                        Dinero
                                    </dt>
                                </div>
                                <div
                                    class="col-span-1 flex flex-col items-center"
                                >
                                    <div
                                        class="bg-amber-500 rounded-full w-1/3 my-2 p-2 font-bold text-center text-xs sm:text-md md:text-lg lg:text-xl"
                                    >
                                        <p class="flex justify-center">
                                            {
                                                sampleCartaPersonaje.atributos
                                                    .fama
                                            }
                                        </p>
                                    </div>
                                    <dt
                                        class="flex justify-center text-xs sm:text-md md:text-lg lg:text-xl font-bold"
                                    >
                                        Fama
                                    </dt>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="flex flex-wrap justify-center items-center mb-8 px-4">
            <div class="w-1/2">
                <input
                    type="text"
                    placeholder="Buscar mazo..."
                    class="w-full px-3 py-2 mb-2 bg-gray-100 rounded-xl shadow-md"
                    id="mazo-search"
                />
                <div
                    class="w-full max-h-[300px] bg-white rounded-xl overflow-y-auto shadow-2xl"
                >
                    <ul class="px-6 py-4" id="mazo-list">
                        {
                            sampleMazos.map((mazo) => (
                                <li class="py-4 px-2 hover:bg-gray-300 transition-colors duration-200 rounded-xl cursor-pointer">
                                    {mazo.nombre} (v{mazo.version})
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </div>
        <div
            class="flex flex-row justify-center items-center gap-2 px-2 sm:px-6 max-w-full md:max-w-[50%] lg:max-w-[30%] mx-auto"
        >
            <button
                id="shuffle-btn"
                class="flex items-center justify-center px-4 py-2 w-1/3 rounded-md font-medium transition-colors duration-300 shadow-sm text-white bg-amber-600 hover:bg-amber-500"
            >
                Mezclar Mazo
            </button>

            <div
                class="flex flex-col justify-center w-1/3 items-center bg-gray-200 rounded-lg p-2 gap-2"
            >
                <div class="flex flex-row justify-between items-center">
                    <span class="text-xl font-bold">2 </span>
                    <span class="text-xl font-bold"> / </span>
                    <span class="text-xl font-bold"> 40</span>
                </div>
                <div class="flex flex-row justify-between items-center">
                    <span class="text-xs">Vistas </span>
                    <span class="text-sm font-bold"> / </span>
                    <span class="text-xs">Restantes </span>
                </div>
            </div>
            <button
                id="presentation-btn"
                class="flex items-center justify-center px-4 py-2 w-1/3 rounded-md font-medium transition-colors duration-300 shadow-sm text-white bg-amber-600 hover:bg-amber-500"
            >
                Modo Presentación
            </button>
        </div>
    </section>
</Layout>

<script>
    // Client-side interactive functionality
    document.addEventListener("DOMContentLoaded", () => {
        // Shuffle button functionality
        const shuffleBtn = document.getElementById("shuffle-btn");
        if (shuffleBtn) {
            shuffleBtn.addEventListener("click", () => {
                console.log("Shuffling deck...");
                // Implementation for shuffling deck would go here
                alert("Mazo mezclado!");
            });
        }

        // Next card button functionality
        const nextCardBtn = document.getElementById("next-card-btn");
        if (nextCardBtn) {
            nextCardBtn.addEventListener("click", () => {
                console.log("Drawing next card...");
                // Implementation for drawing next card would go here
                alert("Tomando siguiente carta...");
            });
        }
    });
</script>
