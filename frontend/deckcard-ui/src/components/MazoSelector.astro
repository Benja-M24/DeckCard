---
import type { Mazo } from "@utils/ApiService";

interface Props {
  mazos: Mazo[];
  selectedMazoId: string | null;
}

const { mazos, selectedMazoId } = Astro.props;
---

<div
  id="selector-mazo"
  class={`flex flex-wrap justify-center items-center mb-8 px-4 ${selectedMazoId ? "hidden" : ""}`}
>
  <div class="w-full md:w-1/2">
    <input
      type="text"
      placeholder="Buscar mazo..."
      class="w-full px-3 py-2 mb-2 bg-gray-200 rounded-xl shadow-md border border-gray-600"
      id="mazo-search"
    />
    <div
      class="w-full max-h-[300px] bg-gray-200 rounded-xl overflow-y-auto shadow-2xl border border-gray-600"
    >
      <ul class="px-6 py-4" id="mazo-list">
        {
          mazos.map((mazo) => (
            <li class="py-4 px-2 hover:bg-gray-100 transition-colors duration-200 rounded-xl cursor-pointer border border-transparent hover:border-amber-300">
              <a href={`?mazo=${mazo.id}`}>
                <div class="flex flex-col">
                  <div class="flex flex-row">
                    <span class="text-sm sm:text-md md:text-lg lg:text-xl font-bold">
                      {mazo.nombre}
                    </span>
                    <span class="text-sm sm:text-md md:text-lg lg:text-xl">
                      (V{mazo.version})
                    </span>
                  </div>
                  <span class="text-xs sm:text-sm md:text-md lg:text-lg">
                    {mazo.fecha_creacion}
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<script>
  // Client-side functionality for mazo search
  document.addEventListener("DOMContentLoaded", () => {
    const mazoSearch = document.getElementById("mazo-search");
    const mazoList = document.getElementById("mazo-list");

    if (mazoSearch && mazoList) {
      mazoSearch.addEventListener("input", (e) => {
        const target = e.target as HTMLInputElement;
        const searchTerm = target.value.toLowerCase();
        const mazoItems = mazoList.getElementsByTagName("li");

        for (let i = 0; i < mazoItems.length; i++) {
          const mazoName =
            mazoItems[i].querySelector("h3")?.textContent?.toLowerCase() || "";
          if (mazoName.includes(searchTerm)) {
            mazoItems[i].style.display = "";
          } else {
            mazoItems[i].style.display = "none";
          }
        }
      });
    }
  });
</script>
