---
import type { Version as VersionType } from "../models/types";

interface Props {
  versions: VersionType[];
  selectedVersionId: string | null;
}

const { versions, selectedVersionId } = Astro.props;
---

<div
  id="selector-version"
  class={`flex flex-wrap justify-center items-center mb-8 px-4 ${selectedVersionId ? "hidden" : ""}`}
>
  <div class="w-full md:w-1/2">
    <input
      type="text"
      placeholder="Buscar versión..."
      class="w-full px-3 py-2 mb-2 bg-gray-200 rounded-xl shadow-md border border-gray-600"
      id="version-search"
    />
    <div
      class="w-full max-h-[300px] bg-gray-200 rounded-xl overflow-y-auto shadow-2xl border border-gray-600"
    >
      <ul class="px-6 py-4" id="version-list">
        {
          versions.map((version) => (
            <li class="py-4 px-2 hover:bg-gray-100 transition-colors duration-200 rounded-xl cursor-pointer border border-transparent hover:border-amber-300">
              <a href={`?version=${version.id}`}>
                <div class="flex flex-col">
                  <div class="flex flex-row">
                    <span class="text-sm sm:text-md md:text-lg lg:text-xl font-bold">
                      {version.nombre}
                    </span>
                    <span class="text-sm sm:text-md md:text-lg lg:text-xl">
                      (V{version.version})
                    </span>
                  </div>
                  <span class="text-xs sm:text-sm md:text-md lg:text-lg">
                    {version.fecha_creacion}
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<script>
  // Client-side functionality for version search
  document.addEventListener("DOMContentLoaded", () => {
    const versionSearch = document.getElementById("version-search");
    const versionList = document.getElementById("version-list");

    if (versionSearch && versionList) {
      versionSearch.addEventListener("input", (e) => {
        const target = e.target as HTMLInputElement;
        const searchTerm = target.value.toLowerCase();
        const versionItems = versionList.getElementsByTagName("li");

        for (let i = 0; i < versionItems.length; i++) {
          const versionName =
            versionItems[i].querySelector("h3")?.textContent?.toLowerCase() ||
            "";
          if (versionName.includes(searchTerm)) {
            versionItems[i].style.display = "";
          } else {
            versionItems[i].style.display = "none";
          }
        }
      });
    }
  });
</script>
