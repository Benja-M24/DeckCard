---
import type { CartaNegocio } from "../models/types";

interface Props {
  carta: CartaNegocio;
}

const { carta } = Astro.props;
---

<div class="carta-negocio">
  <div class="p-4">
    <h2 class="text-2xl font-bold mb-4 text-amber-600">{carta.nombre}</h2>
    <div class="flex justify-center flex-col lg:flex-row gap-6">
      <div class="flex-1 flex flex-col items-center">
        <div class="bg-amber-100 p-4 rounded-lg shadow-md w-full max-w-xs mb-4">
          <div class="border-2 border-amber-600 p-6 rounded-md">
            <h3 class="text-xl font-semibold mb-2 text-center">
              {carta.nombre}
            </h3>
            <p class="text-sm mb-4 italic text-center">❝{carta.frase}❞</p>
            <div class="flex justify-center">
              <span class="inline-block bg-amber-200 text-amber-800 text-xs px-2 py-1 rounded-full">
                Negocio
              </span>
            </div>
          </div>
        </div>
      </div>
      <div class="flex-1 flex flex-col gap-3">
        <div class="text-center md:text-left">
          <h3 class="text-md text-center font-bold">Información</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-2">
            <div class="bg-amber-50 p-3 rounded-md shadow-sm">
              <p class="text-sm font-semibold">
                Industria: <span class="font-normal">{carta.business_industry_name || (carta.business_industry && carta.business_industry.industry_name) || carta.tipo}</span>
              </p>
            </div>
            <div class="bg-amber-50 p-3 rounded-md shadow-sm">
              <p class="text-sm font-semibold">
                Precio: <span class="font-normal">${carta.precio}</span>
              </p>
            </div>
          </div>
        </div>
        <div class="mt-2">
          <h3 class="text-md text-center font-bold mb-1">Beneficios</h3>
          <div class="grid grid-cols-2 gap-4 mb-4">
            <div class="text-center bg-green-50 p-2 rounded-md">
              <span class="block text-xl font-bold text-green-600">
                ${carta.beneficio_base}
              </span>
              <span class="text-sm text-gray-600">Base</span>
            </div>
            <div class="text-center bg-green-50 p-2 rounded-md">
              <span class="block text-xl font-bold text-green-600">
                ${(carta.beneficio_mejorado !== undefined ? carta.beneficio_mejorado : carta.beneficio_final)}
              </span>
              <span class="text-sm text-gray-600">Mejorado</span>
            </div>
          </div>
        </div>
        <div class="mt-2">
          <h3 class="text-md text-center font-bold mb-1">Mejoras Disponibles</h3>
          <div class="flex flex-wrap justify-center gap-2">
            {
              carta.business_upgrade && carta.business_upgrade.length > 0 ? 
                carta.business_upgrade.map((upgrade) => (
                  <span class="px-3 py-1 bg-amber-100 text-amber-800 rounded-full text-sm">
                    {upgrade.upgrade_name}
                  </span>
                )) : 
                Array.isArray(carta.niveles_soportados) && carta.niveles_soportados.length > 0 ? 
                  carta.niveles_soportados.map((nivel) => (
                    <span class="px-3 py-1 bg-amber-100 text-amber-800 rounded-full text-sm">
                      {nivel}
                    </span>
                  )) : 
                  <span class="px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-sm">
                    Sin mejoras disponibles
                  </span>
            }
          </div>
        </div>
        <div>
          <h3 class="text-md text-center font-bold mb-1">Consignas de Juego</h3>
          <ul
            class="list-disc pl-5 text-sm text-gray-700 bg-gray-50 p-2 rounded-md"
          >
            {carta.consignas_juego.map((consigna) => <li>{consigna}</li>)}
          </ul>
        </div>
        <div class="mt-4 bg-amber-50 p-3 rounded-md shadow-sm">
          <p class="text-sm">
            Versión: <span class="font-semibold">#{carta.version}</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
