---
import type { CartaEspecial } from "../models/types";

interface Props {
  carta: CartaEspecial;
}

const { carta } = Astro.props;
---

<div class="carta-especial">
  <div class="p-4">
    <h2 class="text-2xl font-bold mb-4 text-purple-600">{carta.titulo}</h2>
    <div class="flex justify-center flex-col lg:flex-row gap-6">
      <div class="flex-1 flex flex-col items-center">
        <div
          class="bg-purple-100 p-4 rounded-lg shadow-md w-full max-w-xs mb-4"
        >
          {
            carta.imagen && (
              <img
                src={carta.imagen}
                alt={carta.titulo}
                class="w-full h-auto object-cover rounded-md border-2 border-purple-300 shadow-md mb-4"
              />
            )
          }
          <div class="border-2 border-purple-400 p-6 rounded-md">
            <h3 class="text-xl font-semibold mb-2 text-center">
              {carta.titulo}
            </h3>
            <p class="text-sm mb-4 italic text-center">❝{carta.frase}❞</p>
            <div class="flex justify-center">
              <span class="inline-block bg-purple-200 text-purple-800 text-xs px-2 py-1 rounded-full">
                Especial
              </span>
            </div>
          </div>
        </div>
      </div>
      <div class="flex-1 flex flex-col gap-3">
        {carta.descripcion && (
          <div class="text-center md:text-left">
            <h3 class="text-md text-center font-bold">Descripción</h3>
            <div class="bg-gray-50 p-3 rounded-md">
              <p class="text-sm text-gray-700">{carta.descripcion}</p>
            </div>
          </div>
        )}
        <div class="mt-2">
          <h3 class="text-md text-center font-bold mb-1">Efectos</h3>
          <div class="bg-purple-50 p-3 rounded-md shadow-sm">
            <p class="text-sm font-semibold text-center">
              {carta.efecto || "Sin efecto especificado"}
            </p>
          </div>
        </div>
        <div>
          <h3 class="text-md text-center font-bold mb-1">Consignas de Juego</h3>
          <ul
            class="list-disc pl-5 text-sm text-gray-700 bg-gray-50 p-2 rounded-md"
          >
            {carta.consignas_juego.map((consigna) => <li>{consigna}</li>)}
          </ul>
        </div>
        <div class="mt-4 bg-purple-50 p-3 rounded-md shadow-sm">
          <p class="text-sm">
            Versión: <span class="font-semibold">#{carta.version}</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
